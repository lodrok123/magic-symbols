extends SceneTree
const F = preload("res://presentacion/feedback_objeto_3d.gd")
var fallos: int = 0
func comprobar(b: bool,t: String) -> void:
	print("OK " if b else "FALLO ",t)
	if not b: fallos += 1
func _initialize() -> void: call_deferred("correr")
func correr() -> void:
	Terreno3D.cargar_datos(PackedStringArray(["..........","..........","..........","..........","..........",".........."]),{})
	Terreno3D.alto_suelo = 0.0
	Estado.nuevo()
	Flags.nuevo()
	var escena := Node3D.new()
	root.add_child(escena)
	var mi := MeshInstance3D.new()
	mi.mesh = BoxMesh.new()
	var original := StandardMaterial3D.new()
	original.albedo_color = Color(0.6,0.4,0.2)
	mi.material_override = original
	escena.add_child(mi)
	var f = F.instalar(escena,mi)
	f.estado(1,0.7,0.4,1,0.3)
	f._process(0.2)
	comprobar(mi.get_active_material(0) is ShaderMaterial and f.materiales.size()==1,"Material visible preparado para estados combinados")
	comprobar(f.materiales[0].get_shader_parameter("obj_mojado")==1.0 and f.materiales[0].get_shader_parameter("obj_hielo")>0.6,"Humedad y escarcha pueden coexistir")
	comprobar(original.albedo_color==Color(0.6,0.4,0.2),"El material fuente no se modifica")
	comprobar(f.get_node("DescargasObjeto").mesh.get_surface_count()==1,"Descargas reales en una única malla")
	comprobar(f.find_children("*","Light3D",true,false).is_empty() and f.find_children("*","CollisionObject3D",true,false).is_empty(),"Sin luces ni cuerpos físicos añadidos")
	f.estado()
	comprobar(not f.get_node("DescargasObjeto").visible and f.materiales[0].get_shader_parameter("obj_energia")==0.0,"Al cortar energía desaparecen arcos y emisión")
	var copia: Node3D = mi.duplicate()
	escena.add_child(copia)
	var agotado = F.instalar(escena,copia,true)
	agotado.estado(0,0,0,0,1)
	comprobar(copia.get_active_material(0)!=mi.get_active_material(0) and f.materiales[0].get_shader_parameter("obj_agotado")==0.0,"Un residuo clonado no contamina el material del original")
	var especializado := MeshInstance3D.new()
	especializado.mesh = QuadMesh.new()
	var shader := Shader.new()
	shader.code = "shader_type spatial; void fragment(){ ALBEDO=vec3(0.5); }"
	var mat := ShaderMaterial.new()
	mat.shader = shader
	especializado.material_override = mat
	escena.add_child(especializado)
	F.instalar(escena,especializado)
	comprobar(especializado.material_override==mat,"Respeta las referencias de materiales especializados")
	var rafaga: Node3D = F.rafaga(escena,Vector3.ZERO,"onda",Color.WHITE,99)
	comprobar(rafaga.get_child_count()==16 and rafaga.find_children("*","CollisionObject3D",true,false).is_empty(),"Presupuesto acotado y ráfagas decorativas")
	rafaga._process(1.2)
	await process_frame
	comprobar(not is_instance_valid(rafaga),"La ráfaga se libera al terminar")
	var rotacion: Vector3 = mi.rotation
	F.sacudir(mi,0.12)
	F.sacudir(mi,0.03)
	await create_timer(0.4).timeout
	comprobar(mi.rotation.is_equal_approx(rotacion),"Sacudidas repetidas vuelven a la pose original sin apilar tweens")
	var cristal := CristalPulso3D.new()
	cristal.cada = 0.0
	cristal.position = Vector3(1,0,1)
	escena.add_child(cristal)
	cristal.set_process(false)
	var luces: int = cristal.find_children("*","Light3D",true,false).size()
	cristal.cargado_s = CristalPulso3D.T_CARGADO
	cristal.destello = 0.0
	cristal._process(0.5)
	comprobar(cristal._feedback_carga.valores.energia>0.9,"Carga visible después del destello inicial")
	comprobar(absf(cristal._feedback_carga.caja.get_center().x)<0.1 and absf(cristal._feedback_carga.caja.get_center().z)<0.1,"Los arcos usan coordenadas locales incluso fuera del origen")
	cristal._process(CristalPulso3D.T_CARGADO)
	comprobar(cristal.cargado_s==0.0 and cristal._feedback_carga.valores.energia==0.0,"La presentación termina con el reloj de carga real")
	comprobar(cristal.find_children("*","Light3D",true,false).size()==luces,"La carga no reserva luces adicionales")
	var nido := Nido3D.new()
	nido.preparar(Vector2i(2,2))
	escena.add_child(nido)
	var primera: Array = nido.sacudir(100.0)
	var repetida: Array = nido.sacudir(100.1)
	comprobar(not primera.is_empty() and repetida.is_empty() and nido.sacudidas==1,"Plumas solo al dar recurso; la espera no duplica botín")
	var planta := Recolectable3D.new()
	planta.preparar(Vector2i(3,3),"",0.2,null,"bayas")
	escena.add_child(planta)
	comprobar(planta.recoger() and planta._residuo!=null and planta._residuo.visible,"El arbusto agotado conserva una silueta visible")
	for cuerpo in planta._residuo.find_children("*","CollisionObject3D",true,false): comprobar(cuerpo.collision_layer==0,"El residuo no añade obstáculos")
	planta._process(0.3)
	comprobar(planta.objeto=="baya" and planta._residuo==null and not planta.recogido_ya,"Rebrotar restablece arbusto e ingrediente")
	var nexo := NexoRayo3D.new()
	escena.add_child(nexo)
	nexo.mojar()
	comprobar(nexo._agua.position.y>NexoRayo3D.ALTO and nexo._agua.material_override==nexo._mat_agua,"El agua del nexo se ve sobre la piedra y mantiene su material dinámico")
	nexo.secar()
	comprobar(nexo._feedback.valores.energia==0.0,"Un nexo seco no conserva descargas visuales")
	var cuenco := Reactivo3D.new()
	cuenco.preparar("cuenco",Vector2i.ZERO,"",null,null)
	escena.add_child(cuenco)
	cuenco.brotar()
	comprobar(cuenco._feedback_materia.valores.mojado==1.0,"Rellenar humedece visualmente la piedra del cuenco")
	cuenco._vaporizar()
	cuenco._process(4.2)
	comprobar(cuenco._humedad_visual==0.0 and not cuenco._lleno_agua,"El cuenco se seca después de vaciarse sin rellenarlo mecánicamente")
	var pulsador := Pulsador3D.new()
	pulsador.preparar(Vector2i(4,4),"magia",1.0)
	escena.add_child(pulsador)
	var capa: int = pulsador.collision_layer
	var y: float = pulsador._cuerpo.position.y
	pulsador.pulsar()
	await create_timer(0.12).timeout
	comprobar(pulsador.activo and pulsador._cuerpo.position.y<y and pulsador.collision_layer==capa,"Hundimiento animado sin cambiar la colisión lógica")
	pulsador._rearmar()
	await create_timer(0.18).timeout
	comprobar(absf(pulsador._cuerpo.position.y-y)<0.001,"El botón retorna exactamente a su reposo")
	escena.free()
	print("TOTAL DE FALLOS: ",fallos)
	quit(1 if fallos else 0)
